entrypoints ASTProgram ;

token Prod (letter | '{' | '}' | '[' | ']' | '/' | '\\' | '^' | '&' | '+' | '-' | '|' | '!' | '\'' )+ ;

comment "//" ;

ASTLSectionSeparator. ASTSectionSeparator ::= "--" "\n" ;

ASTLProgram.          ASTProgram ::= ASTProperties ASTSectionSeparator ASTAxiom ASTSectionSeparator ASTRules ;

ASTLIProperty.        ASTProperty ::= Prod ":=" Integer ;
ASTLDProperty.        ASTProperty ::= Prod ":=" Double ;
ASTIgnore.            ASTProperty ::= "#ignore" Prod ;
ASTLProperties.       ASTProperties ::= [ASTProperty] ;
separator nonempty ASTProperty "\n" ;

ASTLAxiom.            ASTAxiom ::= Prod ;

ASTLRule.             ASTRule ::=          Prod          "->" Prod ;
ASTLLeftRule.         ASTRule ::= Prod "<" Prod          "->" Prod ;
ASTLRightRule.        ASTRule ::=          Prod ">" Prod "->" Prod ;
ASTLBothRule.         ASTRule ::= Prod "<" Prod ">" Prod "->" Prod ;
ASTLRules.            ASTRules ::= [ASTRule] ;
separator nonempty ASTRule "\n" ;
